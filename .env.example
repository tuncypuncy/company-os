# Copy to .env.local. Demo uses an isolated embedded PostgreSQL database.
APP_MODE=demo
# Set to the exact public origin for live deployments, e.g. https://os.example.com.
APP_ORIGIN=
DEMO_DATA_DIR=.data/demo
# Real data requires APP_MODE=live and an external PostgreSQL connection.
# Supabase: use your server-side PostgreSQL connection; never put it in NEXT_PUBLIC_*.
DATABASE_URL=
# Production PostgreSQL TLS uses certificate verification. Provide a trusted CA if needed.
DATABASE_CA_FILE=
# Private attachment directory; live deployments need durable storage (see docs).
PRIVATE_FILES_DIR=.data/attachments
# Initial owner creation: set securely, then npm run user:create. Not needed for demo.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
BOOTSTRAP_ROLE=OWNER
# Real integration adapters are not yet implemented. These are future server-side requirements.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
CJ_API_KEY=

# Only set true on a persistent private volume; Vercel ephemeral disk is not durable storage.
DURABLE_STORAGE_CONFIRMED=false

# Live uploads: choose supabase, or local with a durable private volume.
PRIVATE_STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=company-os-invoices
