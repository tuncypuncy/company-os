{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json package.json",
    "live:check": "tsx scripts/live-check.ts",
    "integrations:sync": "tsx scripts/sync-integrations.ts",
    "operations:tick": "tsx scripts/operations-tick.ts",
    "test:operations-smoke": "node scripts/operations-smoke.mjs",
    "test:native": "tsx scripts/native-smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "0.577.0",
    "next": "16.3.8",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.8.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
